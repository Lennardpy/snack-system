generator client {
  provider        = "prisma-client-js"
  previewFeatures = []
}

datasource db {
  provider = "postgresql"
}

model Member {
  id           String   @id @default(cuid())
  congressusId Int      @unique
  firstName    String
  lastName     String
  email        String   @unique
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cards       Card[]
  invoices    SaleInvoice[]
  pppInvoices PppInvoice[]
  roles       MemberRole[]
  user        User?
}

// A role/committee a member can belong to, carrying a drink discount applied at
// the PPP bar. E.g. Board = 100% (free), PilsCie = 50%, Bartenders = 25%.
// A member may hold several roles; the BEST (highest) discount wins.
model MemberRole {
  id              String   @id @default(cuid())
  name            String   @unique
  // A role can discount drinks by a percentage and/or a fixed amount per product.
  // The two stack within a role; across a member's roles the BEST (largest) total
  // discount per product wins. PilsCie = 75 cents off each drink → discountCents 75.
  discountPercent Int      @default(0) // 0–100; 100 = free
  discountCents   Int      @default(0) // fixed cents off per product unit
  // "Own drink only": the discount applies to ONE drink per order (the member's
  // own); the rest of the order (rounds for friends) is charged normally. PilsCie.
  ownDrinkOnly    Boolean  @default(false)
  color           String? // optional hex for the admin/POS chip
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())

  members Member[]
}

model Card {
  id        String   @id @default(cuid())
  uid       String   @unique
  name      String?
  createdAt DateTime @default(now())

  memberId String
  member   Member @relation(fields: [memberId], references: [id])
}

// Short-lived session created on card scan — expires after 10 min
model ShopSession {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  memberId  String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  sortOrder Int       @default(0)
  products  Product[]
}

model Product {
  id        String          @id @default(cuid())
  name      String
  price     Int // cents
  stock     Int? // null = unlimited
  published Boolean         @default(false)
  archived  Boolean         @default(false)
  imageUrl  String?
  sortOrder Int             @default(0)
  // Best-before date. In the final 7 days before this date (and after it) the
  // product is sold at 50% off. Null = no expiry, never discounted.
  expiresAt DateTime?
  // VAT rate sent to Congressus on product create/edit. Default 9% (food/drink).
  vatCategory VatCategory   @default(LOW)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  // Congressus product ID — set when the product is created/synced to Congressus.
  congressusProductId     Int? @unique
  // Congressus product OFFER ID — the offer under this product, used as
  // product_offer_id when building sale invoice line items.
  congressusProductOfferId Int? @unique

  categoryId   String
  category     ProductCategory @relation(fields: [categoryId], references: [id])
  invoiceLines InvoiceLine[]
}

model SaleInvoice {
  id          String        @id @default(cuid())
  status      InvoiceStatus @default(CONCEPT)
  totalCents  Int           @default(0)
  exportedAt          DateTime?
  congressusInvoiceId Int?
  exportClaim         String? // id of the export run that claimed it (EXPORTING)
  exportClaimedAt     DateTime?
  createdAt           DateTime      @default(now())
  confirmedAt DateTime?

  memberId String
  member   Member        @relation(fields: [memberId], references: [id])
  lines    InvoiceLine[]
}

model InvoiceLine {
  id        String @id @default(cuid())
  quantity  Int
  unitCents Int // price locked at time of purchase

  invoiceId String
  invoice   SaleInvoice @relation(fields: [invoiceId], references: [id])
  productId String
  product   Product     @relation(fields: [productId], references: [id])
}

enum InvoiceStatus {
  CONCEPT
  CONFIRMED
  // Claimed by a running Congressus export (see exportClaim). Stays here when the
  // outcome is unknown (timeout / crash) until an admin reconciles it, so an
  // export can never create the same Congressus invoice twice.
  EXPORTING
  EXPORTED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(ADMIN)
  createdAt    DateTime @default(now())

  memberId String? @unique
  member   Member? @relation(fields: [memberId], references: [id])

  sessions      Session[]
  passwordSetup PasswordSetupToken?
  pppInvoicesTapped PppInvoice[] @relation("PppTapper")
}

// One-time link to set an account password (used for inviting bartenders).
// Intentionally NON-EXPIRING — there is no expiresAt. Consumed once (usedAt set).
model PasswordSetupToken {
  id        String    @id @default(cuid())
  token     String    @unique @default(cuid())
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  expiresAt DateTime
  createdAt DateTime @default(now())
  // "password" (7 days) or "card" (bar POS: sliding 2 h of inactivity, max 16 h —
  // see src/lib/auth.ts), so a card login never outlives the borrel.
  kind      String   @default("password")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Pending card registration — created when an unregistered card is scanned
model CardRegistration {
  id        String   @id @default(cuid())
  uid       String   // the card UID being registered
  token     String   @unique @default(cuid())
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
}

enum UserRole {
  ADMIN
  MEMBER
  BARTENDER
}

// Activity at which drinks are sold (PPP). Soft-close stops new orders.
enum ActivityStatus {
  OPEN
  CLOSED
}

// Dutch VAT rate buckets sent to Congressus on product create/edit.
// ZERO = 0%, LOW = 9% (food/drink at cost), STANDARD = 21%.
enum VatCategory {
  ZERO
  LOW
  STANDARD
}

// ── PPP — drinks-at-activities POS ────────────────────────────────────────────
// PPP reuses the existing Member and Card tables as the single source of truth;
// it has NO member or card tables of its own. Cards linked via the snack kiosk
// work at the bar with no re-registration.

model PppProductCategory {
  id        String       @id @default(cuid())
  name      String       @unique
  sortOrder Int          @default(0)
  // When true, drinks in this category are FREE for the bartender currently
  // operating the POS when they charge their own card (the association covers
  // these — e.g. soft drinks & 0.0% for the on-shift bartender).
  bartenderFree Boolean  @default(false)
  products  PppProduct[]
}

model PppProduct {
  id        String   @id @default(cuid())
  name      String
  price     Int // cents
  // Optional special/promo price (cents). When set, this is what members pay and
  // ONLY percentage role discounts apply — fixed-cent role discounts are skipped.
  specialPrice Int?
  published Boolean  @default(false)
  archived  Boolean  @default(false)
  imageUrl  String?
  // Optional tile background colour (hex) shown on the POS.
  color     String?
  sortOrder Int      @default(0)
  // VAT rate sent to Congressus on product create/edit. Default 9% (drink).
  vatCategory VatCategory @default(LOW)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Congressus product ID — set when synced to Congressus.
  congressusProductId      Int? @unique
  // Congressus product OFFER ID — used as product_offer_id on sale invoice lines.
  congressusProductOfferId Int? @unique

  categoryId        String
  category          PppProductCategory @relation(fields: [categoryId], references: [id])
  invoiceLines      PppInvoiceLine[]
  activityDiscounts PppActivityDiscount[]
}

model PppActivity {
  id        String         @id @default(cuid())
  name      String
  status    ActivityStatus @default(OPEN)
  date      DateTime       @default(now())
  // Start/end of the borrel (from Alexia when imported). Used as the time window
  // for matching SumUp card revenue; falls back to the `date` calendar day.
  startsAt  DateTime?
  endsAt    DateTime?
  // Whether this activity's per-drink specials are currently applied. Bartenders
  // flip this off in the POS when a special "runs out" mid-borrel.
  discountsActive Boolean  @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  invoices  PppInvoice[]
  discounts PppActivityDiscount[]
  usage     PppActivityUsage[]
  sumup     PppActivitySumup?
}

// An Alexia event the admin deleted from PPP (e.g. an external activity or a free
// drink). Alexia events have no id, so the sync matches by name + day
// (alexiaMatchKey); keys listed here are never re-imported.
model PppDismissedEvent {
  id        String   @id @default(cuid())
  matchKey  String   @unique
  name      String
  createdAt DateTime @default(now())
}

// SumUp card revenue for a finished borrel, saved once the day after it ended
// (past card sales don't change) so it isn't re-fetched from the SumUp API on
// every page view. While the borrel is today/ongoing it is fetched live instead.
model PppActivitySumup {
  id           String   @id @default(cuid())
  revenueCents Int
  count        Int // successful card payments
  byDrink      Json // [{ name, quantity, revenueCents }]
  fetchedAt    DateTime @default(now())

  activityId String      @unique
  activity   PppActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
}

// Manually-entered SBZ stock used at a borrel (kegs in kg, bottles/cans/shots as
// units), keyed by the SBZ price-list item (see src/lib/sbz.ts). Powers the
// cost-of-goods side of the activity P/L. Alexia holds this but isn't public, so
// the admin enters it here.
model PppActivityUsage {
  id         String   @id @default(cuid())
  sbzKey     String // SBZ price-list item key (src/lib/sbz.ts)
  quantity   Float // kg for kegs (LITER items), unit count for bottles/cans/shots
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  activityId String
  activity   PppActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, sbzKey])
}

// A drink special for one activity: this product sells at `priceCents` during the
// activity (e.g. Flügel €1.00 on Flügel Friday) while discounts are active.
model PppActivityDiscount {
  id         String   @id @default(cuid())
  priceCents Int
  createdAt  DateTime @default(now())

  activityId String
  activity   PppActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  productId  String
  product    PppProduct  @relation(fields: [productId], references: [id])

  @@unique([activityId, productId])
}

model PppInvoice {
  id          String        @id @default(cuid())
  // No CONCEPT stage — a bartender confirm goes straight to CONFIRMED.
  status      InvoiceStatus @default(CONFIRMED)
  totalCents  Int           @default(0)
  confirmedAt DateTime      @default(now())
  exportedAt          DateTime?
  congressusInvoiceId Int?
  exportClaim         String? // id of the export run that claimed it (EXPORTING)
  exportClaimedAt     DateTime?

  memberId   String
  member     Member       @relation(fields: [memberId], references: [id])
  activityId String
  activity   PppActivity  @relation(fields: [activityId], references: [id])
  // The bartender ("tapper") who rang this order up on the POS. Nullable for
  // orders created before this was tracked.
  createdById String?
  createdBy   User?        @relation("PppTapper", fields: [createdById], references: [id])
  lines      PppInvoiceLine[]
}

model PppInvoiceLine {
  id        String @id @default(cuid())
  quantity  Int
  unitCents Int // final price charged per unit (after specials + role discounts)
  // Snapshots for discount/budget reporting (nullable for pre-feature rows):
  listCents    Int? // the product's normal list price at sale time
  specialCents Int? // the activity drink-special price applied, or null if none
  // True when this line was comped free because the on-shift bartender charged
  // their own card for a bartender-free category. The association covers the cost
  // (= listCents); surfaced separately on the dashboard.
  bartenderFree Boolean @default(false)

  invoiceId String
  invoice   PppInvoice @relation(fields: [invoiceId], references: [id])
  productId String
  product   PppProduct @relation(fields: [productId], references: [id])
}

// SBZ price list (what the association pays SBZ for drinks — the cost side of a
// borrel's P/L). Versioned: each list is valid from `validFrom` until the next
// one, and a borrel's cost of goods uses the list valid on the borrel's date, so
// a new price list never changes the cost of earlier borrels.
model SbzPriceList {
  id        String     @id @default(cuid())
  label     String // e.g. "SBZ price list effective 01/10/2026 (V2)"
  validFrom DateTime   @unique // start of day (UTC) the prices apply from
  source    String? // "initial", "PDF: <filename>", "manual edit"
  createdAt DateTime   @default(now())
  items     SbzPrice[]
}

// One item on a price list. `key` is stable across versions (usage is stored
// against it): kegs are LITER (usage entered in kg ≈ liters), the rest UNIT.
model SbzPrice {
  id            String       @id @default(cuid())
  key           String
  name          String
  section       String // "Beer", "On request", "Soft drinks", "Other"
  unit          String // "LITER" | "UNIT"
  vatRate       Int // 21 or 9
  costExclCents Int // net, per liter (kegs) or per unit
  costInclCents Int // gross (what SBZ invoices), per liter or per unit
  onRequest     Boolean      @default(false)
  sortOrder     Int          @default(0)

  listId String
  list   SbzPriceList @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@unique([listId, key])
}
